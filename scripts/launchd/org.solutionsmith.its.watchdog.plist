<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ITS watchdog. Per Operational Standards v8 §2.

  HOURLY since 2026-08-07 (was StartCalendarInterval 07:00 daily). A 12.7-hour
  Smartsheet outage on 2026-08-06 — breaker OPEN 729 min, every Smartsheet-backed
  daemon short-circuiting, "approved sends FROZEN and nothing is being filed" —
  paged ZERO times, because the watchdog is the fleet's only cross-daemon observer
  and it had already run for the day. Its cadence IS the outage-detection floor.

  NOT every check runs hourly: scripts/watchdog.py DAILY_ONLY_CHECKS keeps the
  expensive / mutating / daily-rhythm checks (D, G, I, L, O, U, W) on a ~24h tier,
  gated by the watchdog_daily.last_run marker. See that constant's comment block for
  why each one would be harmful at 1h.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.solutionsmith.its.watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>__ITS_HOME__/.venv/bin/python</string>
        <string>__ITS_HOME__/scripts/watchdog.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__ITS_HOME__</string>

    <key>StandardOutPath</key>
    <string>__ITS_HOME__/logs/launchd/watchdog.out.log</string>

    <key>StandardErrorPath</key>
    <string>__ITS_HOME__/logs/launchd/watchdog.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>

    <key>StartInterval</key>
    <integer>3600</integer>

    <!-- RunAtLoad is TRUE for an interval daemon (matches picklist-sync, the existing
         hourly precedent). The A2 rationale for FALSE applied to the old
         StartCalendarInterval form, where RunAtLoad would MIS-fire a calendar job on
         every login (e.g. a Friday compile on a Tuesday boot). That hazard does not
         exist here: an interval sweep is idempotent and carries no calendar meaning,
         and the calendar-bearing work — the weekly-compile catch-up — is Check I,
         which is window-guarded on its own trigger date, not on when the sweep runs.
         Firing once at load also closes the post-reboot gap that a bare 3600s timer
         would otherwise leave. -->
    <key>RunAtLoad</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
